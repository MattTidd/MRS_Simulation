<?xml version = "1.0"?>
<robot xmlns:xacro = "http://www.ros.org/wiki/xacro">
    <!-- PROPERTIES -->
    <xacro:property name = "mu1" value = "1.0"/>
    <xacro:property name = "mu2" value = "0.3"/>
    <xacro:property name = "minDepth" value = "0.0001"/>
    <xacro:property name = "piValue" value = "3.14159265359"/>

    <!-- MACROS -->
    <xacro:macro name = "common_joint" params = "name">
        <gazebo reference = "${name}">
            <mu1>${mu1}</mu1>
            <mu2>${mu2}</mu2>
            <minDepth value = "${minDepth}"/>
            <fdir1>1 0 0</fdir1>
        </gazebo>
    </xacro:macro>

    <!-- GAZEBO -->
    <xacro:common_joint name = "${prefix}_front_right_joint"/>
    <xacro:common_joint name = "${prefix}_front_left_joint"/>
    <xacro:common_joint name = "${prefix}_back_right_joint"/>
    <xacro:common_joint name = "${prefix}_back_left_joint"/>

    <!-- PLUGINS -->
    <!-- lidar sensor -->
    <gazebo reference = "${prefix}_lidar_link">
        <sensor name = "${prefix}_laser" type = "gpu_lidar">
            <pose>0 0 0.0093 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>60</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>1600</samples>
                        <min_angle>${-piValue}</min_angle>
                        <max_angle>${piValue}</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.13</min>
                    <max>12.0</max>
                </range>
            </lidar>
            <topic>${prefix}_scan</topic>
            <gz_frame_id>${prefix}_lidar_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- IMU plugin -->
    <gazebo>
        <plugin name = "ignition::gazebo::systems::Imu" filename = "ignition-gazebo-imu-system"/>
    </gazebo>

    <!-- IMU sensor -->
    <gazebo reference = "${prefix}_imu_link">
        <sensor name = "imu_sensor" type = "imu">
            <always_on>1</always_on>
            <update_rate>60</update_rate>
            <visualize>true</visualize>
            <topic>${prefix}_imu_data</topic>
        </sensor>
    </gazebo>
</robot>