<?xml version = "1.0"?>
<robot xmlns:xacro = "http://www.ros.org/wiki/xacro">
    <!-- PROPERTIES -->
    <xacro:property name = "a" value = "1.0"/>          <!-- scalar used for inertia-->

    <!-- MATERIALS -->
    <material name = "blue">
        <color rgba = "0.18 0.61 0.95 0.9"/>
    </material>

    <material name = "red">
        <color rgba = "0.95 0.18 0.18 0.9"/>
    </material>

    <!-- MACROS -->
    <xacro:macro name = "cylinder_inertia" params = "mass radius length">
        <inertia
            ixx = "${a * mass * (3 * radius**2 + length**2) / 12}"
            ixy = "0"
            ixz = "0"
            iyy = "${a * mass * (3 * radius**2 + length**2) / 12}"
            iyz = "0"
            izz = "${a * mass * radius**2 / 12}"
        />
    </xacro:macro>

    <!-- LINKS -->
    <!-- base link -->
    <link name = "${prefix}_base_link">
    </link>

    <!-- body link -->
    <link name = "${prefix}_body_link">
        <visual>
            <origin xyz = "0 0 0.00475" rpy = "0 0 0"/>
            <geometry>
                <cylinder radius = "0.1" length = "0.0095"/>
            </geometry>
            <xacro:if value = "${type == 'typeA'}">
                <material name = "blue"/>
            </xacro:if>
            <xacro:if value = "${type == 'typeB'}">
                <material name = "red"/>
            </xacro:if>
        </visual>

        <collision>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <geometry>
                <cylinder radius = "0.1" length = "0.0000001"/>
            </geometry>
        </collision>

        <inertial>
            <mass value = "0.01"/>
            <xacro:cylinder_inertia 
                mass = "0.01"
                radius = "0.1"
                length = "0.0095"
            />
        </inertial>
    </link>

    <gazebo>
        <static>true</static>
    </gazebo>

    <!-- JOINTS -->
    <joint name = "${prefix}_base_joint" type = "fixed">
        <parent link = "${prefix}_base_link"/>
        <child link = "${prefix}_body_link"/>
        <origin xyz = "0 0 0" rpy = "0 0 0"/>
    </joint>
</robot>